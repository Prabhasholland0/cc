# Copy this file to .env and fill in your own values. Never commit .env.

# Staff portal passcode (required for the staff login).
ADMIN_SECRET=

# Email alerts to the owner for new bookings, callbacks, cancellations and reschedules.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_USER=yourname@gmail.com
SMTP_PASS=
ALERT_EMAIL_TO=owner@example.com
# Optional: other mail providers, a different sender, or your live site address for links.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# ALERT_EMAIL_FROM="Clean Corners Website <yourname@gmail.com>"
# SITE_URL=https://cleancorners.in
